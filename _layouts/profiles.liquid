---
layout: page
---
<div class="post">
  <article>
    {% if page.group_photo and page.group_photo.image %}
      {% assign group_photo_path = page.group_photo.image | prepend: 'assets/img/' %}
      <div class="members-group-intro">
        {%
          include figure.liquid
          loading="eager"
          path=group_photo_path
          class="img-fluid z-depth-1 rounded members-group-photo"
          sizes="(min-width: 930px) 900px, 95vw"
          alt=page.group_photo.alt
          caption=page.group_photo.caption
        %}
      </div>
    {% endif %}

    {% if page.profiles_heading %}
      <h2 class="members-list-heading">{{ page.profiles_heading }}</h2>
    {% endif %}

    {% if page.profiles %}
      <div class="member-list">
        {% for profile in page.profiles %}
          {% assign info_parts = profile.more_info | split: '</p>' %}
          {% assign member_name = info_parts[1] | strip_html | strip %}
          <section class="member">
            {% if profile.image %}
              {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
              <div
                class="member-photo"
                {% if profile.image_position %}
                  style="--member-img-pos: {{ profile.image_position }}"
                {% endif %}
              >
                {% include figure.liquid loading="lazy" path=profile_image_path class="member-img z-depth-1" sizes="(min-width: 576px) 180px, 96px" alt=member_name %}
              </div>
            {% endif %}
            {% if profile.more_info %}
              <div class="member-head">
                <h3 class="member-name">{{ member_name }}</h3>
                {{ profile.more_info }}
              </div>
            {% endif %}
            <div class="member-text">
              {% if profile.content %}
                {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
                {{ profile_content | markdownify }}
              {% endif %}
            </div>
          </section>
        {% endfor %}
      </div>
    {% endif %}
  </article>
</div>
