{% comment %}
  Course cards grouped by year (based on al-folio v0.16.3 _includes/courses.liquid).
  Within a year, courses sort by `term_order` (e.g. 1 = spring, 2 = fall), newest first.
{% endcomment %}
{% if site.teachings.size > 0 %}
  <div class="courses">
    {% assign courses_by_year = site.teachings | sort: 'year' | reverse | group_by: 'year' %}
    {% for year_group in courses_by_year %}
      <h4 class="year">{{ year_group.name }}</h4>
      <div class="course-list">
        {% assign year_courses = year_group.items | sort: 'term_order' | reverse %}
        {% for course in year_courses %}
          <a class="course-item" href="{{ course.url | relative_url }}">
            <span class="course-title">{{ course.title }}</span>
            <span class="course-meta">
              {% if course.course_code %}<span>{{ course.course_code }}</span>{% endif %}
              {% if course.term %}<span>{{ course.term }}</span>{% endif %}
            </span>
            {% if course.summary %}<span class="course-description">{{ course.summary }}</span>{% endif %}
          </a>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
{% endif %}
